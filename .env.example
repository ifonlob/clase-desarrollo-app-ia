# Application
APP_NAME=TDAI
DEBUG=false
USE_MOCKS=true

# Database
DATABASE_URL=postgresql+asyncpg://tdai:tdai_pass@localhost:5432/tdai_db

# Valkey (Redis-compatible) — db 0 = cache, db 1 = Celery broker, db 2 = Celery results
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Authentik (Phase 3 — leave empty for now)
AUTHENTIK_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Frontend (VITE_ prefix required by Vite)
VITE_API_BASE_URL=http://localhost:8080
